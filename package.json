{
  "name": "rayls-automation",
  "version": "1.0.0",
  "description": "Automated testing suite for Rayls E2E tests",
  "license": "Apache-2.0",
  "scripts": {
    "test:e2e-governance-api": "npx hardhat test ./test/e2e/governance-api/* --bail",
    "test:e2e-enygma-payment": "npx hardhat test ./test/e2e/enygma/enygma-payment/* --bail",
    "test:e2e-enygma-transfers": "npx hardhat test ./test/e2e/enygma/enygma-payment/Enygma_Transfer_Scenarios.ts --bail",
    "test:e2e-enygma-batch": "npx hardhat test ./test/e2e/enygma/enygma-payment/Enygma_Batch_Scenarios.ts --bail",
    "test:e2e-enygma-dvp": "npx hardhat test ./test/e2e/enygma/enygma-dvp/* --bail",
    "test:resilience": "npx hardhat test test/e2e/security/resilience/*.ts test/e2e/security/resilience/**/*.ts",
    "test:e2e-full": "npx hardhat test test/e2e/*.ts test/e2e/backend/**/*.ts test/e2e/governance-api/*.ts test/e2e/public-chain/*.ts test/e2e/enygma/enygma-dvp/*.ts test/e2e/enygma/enygma-payment/*.ts test/e2e/security/*.ts test/e2e/security/**/*.ts test/e2e/security/resilience/**/*.ts --bail",
    "test:e2e-full:lcov": "c8 --reporter=lcov --reports-dir=./coverage npm run test:e2e-full",
    "test:e2e-full-no-security": "npx hardhat test test/e2e/*.ts test/e2e/backend/token-operations/Token_Lock_ERC20.ts test/e2e/backend/token-operations/Token_Lock_ERC721.ts test/e2e/backend/token-operations/Token_Lock_ERC1155.ts test/e2e/backend/token-operations/Token_Lock_CrossNode.ts test/e2e/backend/token-operations/Token_Lock_CrossNode_Negative.ts test/e2e/backend/token-operations/Token_Registration.ts test/e2e/backend/user-onboarding/User_Onboarding.ts test/e2e/governance-api/*.ts test/e2e/public-chain/*.ts test/e2e/enygma/enygma-dvp/*.ts test/e2e/enygma/enygma-payment/*.ts --bail",
    "test:backend": "npx hardhat test test/e2e/backend/token-operations/Token_Lock_ERC20.ts test/e2e/backend/token-operations/Token_Lock_ERC721.ts test/e2e/backend/token-operations/Token_Lock_ERC1155.ts test/e2e/backend/token-operations/Token_Lock_CrossNode.ts test/e2e/backend/token-operations/Token_Lock_CrossNode_Negative.ts test/e2e/backend/token-operations/Token_Registration.ts test/e2e/backend/user-onboarding/User_Onboarding.ts --bail",
    "test:backend-negative": "npx hardhat test test/e2e/backend/token-operations/Token_Lock_ERC20_Negative.ts test/e2e/backend/token-operations/Token_Lock_ERC721_Negative.ts test/e2e/backend/token-operations/Token_Lock_ERC1155_Negative.ts test/e2e/backend/token-operations/Token_Lock_Enygma_Negative.ts test/e2e/backend/token-operations/Token_Registration_Negative.ts test/e2e/backend/user-onboarding/User_Onboarding_Negative.ts --bail",
    "test:backend-all": "npx hardhat test test/e2e/backend/token-operations/*.ts test/e2e/backend/user-onboarding/*.ts --bail",
    "test:smoke": "npx hardhat test test/e2e/*.ts test/e2e/*/*.ts test/e2e/*/*/*.ts --grep '@smoke' --bail",
    "test:hubless": "npx hardhat test test/e2e/*.ts test/e2e/*/*.ts test/e2e/*/*/*.ts --grep '@hubless' --bail",
    "test:regression": "npx hardhat test ./test/e2e/enygma/**/*.ts --grep '@regression' --bail",
    "test:enygma:1to1": "npx hardhat test ./test/e2e/enygma/enygma-payment/Enygma_Transfer_Scenarios.ts --grep '@1to1'",
    "test:enygma:1to2": "npx hardhat test ./test/e2e/enygma/enygma-payment/Enygma_Transfer_Scenarios.ts --grep '@1to2'",
    "test:enygma:1to3": "npx hardhat test ./test/e2e/enygma/enygma-payment/Enygma_Transfer_Scenarios.ts --grep '@1to3'",
    "test:enygma:1to4": "npx hardhat test ./test/e2e/enygma/enygma-payment/Enygma_Transfer_Scenarios.ts --grep '@1to4'",
    "test:enygma:1to5": "npx hardhat test ./test/e2e/enygma/enygma-payment/Enygma_Transfer_Scenarios.ts --grep '@1to5'",
    "test:enygma:transfers": "npx hardhat test ./test/e2e/enygma/enygma-payment/Enygma_Transfer_Scenarios.ts",
    "test:enygma:batch": "npx hardhat test ./test/e2e/enygma/enygma-payment/Enygma_Batch_Scenarios.ts",
    "test:enygma:batch:1to1": "npx hardhat test ./test/e2e/enygma/enygma-payment/Enygma_Batch_Scenarios.ts --grep '@1to1'",
    "test:enygma:batch:1to2": "npx hardhat test ./test/e2e/enygma/enygma-payment/Enygma_Batch_Scenarios.ts --grep '@1to2'",
    "test:enygma:batch:1to3": "npx hardhat test ./test/e2e/enygma/enygma-payment/Enygma_Batch_Scenarios.ts --grep '@1to3'",
    "test:enygma:batch:1to4": "npx hardhat test ./test/e2e/enygma/enygma-payment/Enygma_Batch_Scenarios.ts --grep '@1to4'",
    "test:enygma:batch:1to5": "npx hardhat test ./test/e2e/enygma/enygma-payment/Enygma_Batch_Scenarios.ts --grep '@1to5'",
    "test:e2e:parallel": "PARALLEL_WORKERS=2 node scripts/runners/e2e-parallel-runner.js 'test:e2e-full' -- --bail",
    "test:smoke:parallel": "PARALLEL_WORKERS=2 node scripts/runners/smoke-parallel-runner.js 'test:smoke' -- --bail",
    "test:merge-reports": "npx mochawesome-merge mochawesome-report/worker-*.json -o mochawesome-report/mochawesome.json && npx marge mochawesome-report/mochawesome.json -o mochawesome-report --inline",
    "sync-contracts-local": "bash ./scripts/sync-contracts-local.sh",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.9",
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/hardhat-upgrades": "^3.1.1",
    "@solarity/hardhat-gobind": "^1.2.2",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "c8": "11.0.0",
    "hardhat": "^2.22.15",
    "hardhat-artifactor": "^0.2.0",
    "hardhat-contract-sizer": "^2.10.0",
    "mocha": "^11.7.1",
    "mochawesome": "^7.1.4",
    "@types/pg": "^8.10.9",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.3.2",
    "mongodb": "^6.12.0",
    "prettier": "^3.3.2",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2"
  },
  "dependencies": {
    "@ethersproject/contracts": "^5.8.0",
    "@ethersproject/wallet": "^5.8.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.6",
    "@openzeppelin/contracts-upgradeable": "^5.0.2",
    "axios": "1.13.5",
    "chai": "^4.5.0",
    "cmd-ts": "^0.13.0",
    "dotenv": "^16.4.5",
    "pg": "^8.11.3",
    "ethers": "^6.15.0",
    "poseidon-solidity": "^0.0.5",
    "typescript": "^5.6.3"
  }
}
